# Monolith API Base URL (FastAPI Monolith listening on port 8000)
# Local development:
VITE_API_URL=http://localhost:8000

# Production behind the bundled nginx (same-origin, recommended for Docker/EC2):
# VITE_API_URL=/

# Production (API on a separate domain):
# VITE_API_URL=https://api.thinkaloudai.tech

# LiveKit WebRTC Cloud URL
VITE_LIVEKIT_URL=wss://thinkaloudai-3166kske.livekit.cloud

# Admin users (comma-separated emails)
