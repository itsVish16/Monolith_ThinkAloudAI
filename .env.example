# =============================================================================
# Docker Compose / infrastructure settings
# Copy to .env and change the password before going live.
# =============================================================================

POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me-to-a-strong-password
POSTGRES_DB=thinkaloud_monolith

# Uvicorn worker processes (1 is safe on 2 GB instances; raise on larger hosts)
UVICORN_WORKERS=1

# Host port for the frontend (nginx)
FRONTEND_PORT=80

# Optional: comma-separated admin emails baked into the frontend at build time
VITE_ADMIN_EMAILS=you@example.com
