# =============================================================================
# ThinkAloudAI Monolith - Environment Configuration Reference
# Copy this file to .env before starting the application:
#   cp .env.example .env
# =============================================================================

# --- Application & Server Settings ---
APP_NAME="ThinkAloudAI Platform"
APP_VERSION="1.0.0"
DEBUG=false
PORT=8000
API_PREFIX=/api/v1
FRONTEND_BASE_URL=http://localhost:5173
CORS_ALLOWED_ORIGINS=https://thinkaloudai.tech,https://www.thinkaloudai.tech,http://localhost:3000,http://localhost:5173,http://127.0.0.1:3000,http://localhost:8000,http://127.0.0.1:8000

# --- PostgreSQL 16 Database Configuration ---
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=thinkaloud_monolith
POSTGRES_PORT=5432
# Directory on host machine pinned for PostgreSQL storage to guarantee zero data loss
POSTGRES_DATA_DIR=/var/lib/thinkaloud/postgres_data
# Direct SQLAlchemy Async Database URL (used for local development outside Docker)
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/thinkaloud_monolith

# Database Connection Pool Tuning (Tuned for AWS RDS micro instances)
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=5
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=300

# AWS RDS PostgreSQL Configuration (Optional - synthesizes DATABASE_URL if RDS_HOST & RDS_DB_NAME are set)
# RDS_HOST=
# RDS_PORT=5432
# RDS_DB_NAME=
# RDS_USERNAME=
# RDS_PASSWORD=
# RDS_SSL_MODE=prefer
# RDS_CA_BUNDLE_PATH=/app/certs/global-bundle.pem

# --- Redis 7 Configuration ---
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379/0
REDIS_MAX_CONNECTIONS=100

# --- Security & JWT Authentication ---
# Generate a strong 32+ byte random secret for production (e.g. openssl rand -hex 32)
JWT_SECRET_KEY=change-me-generate-with-openssl-rand-hex-32
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_MINUTES=10080
ADMIN_EMAILS=admin@thinkaloudai.tech,vishal@example.com,vishal@thinkaloud.ai

# Rate Limiting & Auth Policies
ENABLE_RATE_LIMITING=true
RATE_LIMIT_SIGNUP=5/minute
RATE_LIMIT_LOGIN=10/minute
RATE_LIMIT_REFRESH=10/minute
RATE_LIMIT_FORGOT_PASSWORD=5/minute
RATE_LIMIT_RESET_PASSWORD=5/minute
RATE_LIMIT_VERIFY_EMAIL=5/minute
RATE_LIMIT_RESEND_VERIFICATION=5/minute

# --- Email Notifications (Resend) ---
RESEND_API_KEY=
EMAIL_FROM=ThinkAloudAI <onboarding@resend.dev>
EMAIL_DELIVERY_ENABLED=false

# --- LiveKit WebRTC Cloud (Real-time Audio / Voice Interviewer) ---
LIVEKIT_URL=wss://thinkaloudai-3166kske.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# --- Sarvam AI (Voice STT / TTS & Voice Agent LLM) ---
SARVAM_API_KEY=
SARVAM_BASE_URL=https://api.sarvam.ai/v2
SARVAM_MODEL=gemma4
SARVAM_TTS_MODEL=bulbul:v4-flash
SARVAM_TTS_SPEAKER=shubh_en_numbers
SARVAM_TTS_LANGUAGE=en-IN
SARVAM_TTS_PACE=1.0
SARVAM_TTS_SAMPLE_RATE=24000
SARVAM_TTS_WS_URL=wss://api.sarvam.ai/text-to-speech/ws
SARVAM_STT_MODEL=saaras:v3
SARVAM_STT_LANGUAGE=en-IN

# --- LLM Providers (Evaluation & Reasoning) ---
FIREWORKS_API_KEY=
FIREWORKS_BASE_URL=https://api.fireworks.ai/inference/v1
FIREWORKS_MODEL=accounts/fireworks/routers/glm-5p2-fast

OPENAI_API_KEY=
GEMINI_API_KEY=
ANTHROPIC_API_KEY=

# --- Code Execution Sandbox & Search ---
E2B_API_KEY=
TAVILY_API_KEY=

# --- AssemblyAI (Realtime WebSocket STT) ---
ASSEMBLYAI_API_KEY=

# --- Observability & Telemetry (LangSmith, Opik, Datadog) ---
LANGSMITH_API_KEY=
LANGCHAIN_TRACING_V2=true
LANGSMITH_PROJECT=ThinkAloudAI
LANGSMITH_ENDPOINT=https://api.smith.langchain.com

OPIK_API_KEY=
OPIK_WORKSPACE=default
OPIK_PROJECT_NAME=ThinkAloud.ai

DD_API_KEY=
DD_SITE=datadoghq.com
DD_ENV=production
DD_SERVICE=thinkaloudai-monolith
DD_VERSION=1.0.0
DD_AGENT_HOST=localhost
DD_AGENT_PORT=8126
DD_TRACE_ENABLED=false
DD_LOGS_INJECTION=true
