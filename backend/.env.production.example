# =============================================================================
# ThinkAloudAI Production Environment Configuration (.env)
# Specifically configured for AWS EC2 + AWS RDS PostgreSQL + Local Redis
# =============================================================================

# --- Server & Networking ---
APP_NAME="ThinkAloudAI Platform"
APP_VERSION="1.0.0"
DEBUG=false
PORT=8000
API_PREFIX=/api/v1
# Public domain or IP for CORS and frontend
FRONTEND_BASE_URL=https://thinkaloudai.tech
CORS_ALLOWED_ORIGINS=https://thinkaloudai.tech,https://www.thinkaloudai.tech,http://localhost:5173,http://localhost:8000

# --- Amazon RDS PostgreSQL Configuration ---
# OPTION A (Recommended): Direct SQLAlchemy URL (SSL parameters handled automatically)
# Replace <USERNAME>, <PASSWORD>, <RDS_ENDPOINT>, and <DB_NAME>
DATABASE_URL=postgresql+asyncpg://<RDS_USERNAME>:<RDS_PASSWORD>@<RDS_ENDPOINT>:5432/<RDS_DB_NAME>

# OPTION B: Dedicated RDS variables (auto-synthesizes DATABASE_URL with proper URL encoding)
# RDS_HOST=your-db-instance.xxxxxx.us-east-1.rds.amazonaws.com
# RDS_PORT=5432
# RDS_DB_NAME=thinkaloud_prod
# RDS_USERNAME=postgres
# RDS_PASSWORD=your_secure_rds_password
# RDS_SSL_MODE=prefer

# RDS Connection Pool Tuning (optimized for AWS RDS micro/small instances)
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=5
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=300

# --- EC2 Local Redis Configuration ---
REDIS_PORT=6379
REDIS_URL=redis://127.0.0.1:6379/0
REDIS_MAX_CONNECTIONS=100

# --- Security & JWT Authentication ---
# Generate using: openssl rand -hex 32
JWT_SECRET_KEY=change-me-to-a-secure-random-32-byte-hex-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_MINUTES=10080
ADMIN_EMAILS=vishalsaini160204@gmail.com,admin@thinkaloudai.tech

# Rate Limiting & Auth Policies
ENABLE_RATE_LIMITING=true
RATE_LIMIT_TRUST_PROXY_HEADERS=true
RATE_LIMIT_SIGNUP=5/minute
RATE_LIMIT_LOGIN=10/minute
RATE_LIMIT_REFRESH=10/minute
RATE_LIMIT_FORGOT_PASSWORD=5/minute
RATE_LIMIT_RESET_PASSWORD=5/minute
RATE_LIMIT_VERIFY_EMAIL=5/minute
RATE_LIMIT_RESEND_VERIFICATION=5/minute

# --- Email Notifications (Resend) ---
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx
EMAIL_FROM=ThinkAloudAI <onboarding@resend.dev>
EMAIL_DELIVERY_ENABLED=true

# --- LiveKit WebRTC Cloud (Voice Interviewer Arena) ---
LIVEKIT_URL=wss://thinkaloudai-3166kske.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# --- Sarvam AI (Voice STT / TTS & Voice Agent LLM) ---
SARVAM_API_KEY=
SARVAM_BASE_URL=https://api.sarvam.ai/v2
SARVAM_MODEL=gemma4
SARVAM_TTS_MODEL=bulbul:v4-flash
SARVAM_TTS_SPEAKER=shubh_en_numbers
SARVAM_TTS_LANGUAGE=en-IN
SARVAM_TTS_PACE=1.0
SARVAM_TTS_SAMPLE_RATE=24000
SARVAM_TTS_WS_URL=wss://api.sarvam.ai/text-to-speech/ws
SARVAM_STT_MODEL=saaras:v3
SARVAM_STT_LANGUAGE=en-IN

# --- LLM Providers (Evaluation & Reasoning) ---
FIREWORKS_API_KEY=
FIREWORKS_BASE_URL=https://api.fireworks.ai/inference/v1
FIREWORKS_MODEL=accounts/fireworks/routers/glm-5p2-fast

OPENAI_API_KEY=
GEMINI_API_KEY=
ANTHROPIC_API_KEY=

# --- Code Execution Sandbox & Search ---
E2B_API_KEY=
TAVILY_API_KEY=
